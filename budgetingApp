<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>MoneyWise - Personal Finance</title>

  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: Inter, Arial, sans-serif;
      background: #f5f7fb;
      color: #172033;
    }

    button,
    input,
    select {
      font: inherit;
    }

    button {
      cursor: pointer;
    }

    .app {
      display: flex;
      min-height: 100vh;
    }

    /* SIDEBAR */

    .sidebar {
      width: 240px;
      background: #111827;
      color: white;
      padding: 25px 18px;
      position: fixed;
      height: 100vh;
      left: 0;
      top: 0;
    }

    .logo {
      font-size: 24px;
      font-weight: 800;
      margin-bottom: 35px;
      padding-left: 10px;
    }

    .logo span {
      color: #4ade80;
    }

    .nav button {
      width: 100%;
      background: transparent;
      border: 0;
      color: #cbd5e1;
      padding: 13px 12px;
      text-align: left;
      border-radius: 8px;
      margin-bottom: 5px;
    }

    .nav button:hover,
    .nav button.active {
      background: #1f2937;
      color: white;
    }

    /* MAIN */

    .main {
      margin-left: 240px;
      width: calc(100% - 240px);
      padding: 30px;
    }

    .page {
      display: none;
    }

    .page.active {
      display: block;
    }

    .topbar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 25px;
    }

    .topbar h1 {
      font-size: 28px;
    }

    .topbar p {
      color: #64748b;
      margin-top: 5px;
    }

    .primary-btn {
      background: #16a34a;
      color: white;
      border: none;
      padding: 12px 18px;
      border-radius: 8px;
      font-weight: 600;
    }

    .primary-btn:hover {
      background: #15803d;
    }

    /* CARDS */

    .cards {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 18px;
      margin-bottom: 25px;
    }

    .card {
      background: white;
      padding: 22px;
      border-radius: 14px;
      box-shadow: 0 2px 10px rgba(0,0,0,.04);
    }

    .card-title {
      color: #64748b;
      font-size: 14px;
      margin-bottom: 8px;
    }

    .card-value {
      font-size: 27px;
      font-weight: 750;
    }

    .income {
      color: #16a34a;
    }

    .expense {
      color: #dc2626;
    }

    .balance {
      color: #2563eb;
    }

    /* GRID */

    .grid {
      display: grid;
      grid-template-columns: 1.5fr 1fr;
      gap: 20px;
    }

    .panel {
      background: white;
      border-radius: 14px;
      padding: 22px;
      box-shadow: 0 2px 10px rgba(0,0,0,.04);
    }

    .panel-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 18px;
    }

    .panel-header h2 {
      font-size: 18px;
    }

    /* TRANSACTIONS */

    .transaction {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 14px 0;
      border-bottom: 1px solid #edf0f4;
    }

    .transaction:last-child {
      border-bottom: none;
    }

    .transaction-left {
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .category-icon {
      width: 40px;
      height: 40px;
      border-radius: 10px;
      display: grid;
      place-items: center;
      background: #f1f5f9;
      font-size: 18px;
    }

    .transaction-name {
      font-weight: 600;
    }

    .transaction-category {
      color: #94a3b8;
      font-size: 12px;
      margin-top: 3px;
    }

    .amount {
      font-weight: 700;
    }

    /* FORMS */

    .form {
      display: grid;
      gap: 15px;
    }

    .form-group {
      display: grid;
      gap: 7px;
    }

    .form-group label {
      font-size: 13px;
      font-weight: 600;
      color: #475569;
    }

    input,
    select {
      width: 100%;
      padding: 12px;
      border: 1px solid #dbe1e8;
      border-radius: 8px;
      outline: none;
      background: white;
    }

    input:focus,
    select:focus {
      border-color: #16a34a;
    }

    /* CATEGORY */

    .category-list {
      display: grid;
      gap: 10px;
    }

    .category-item {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 13px;
      background: #f8fafc;
      border-radius: 9px;
    }

    .category-info {
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .delete-btn {
      border: 0;
      background: transparent;
      color: #ef4444;
      font-size: 13px;
    }

    /* BUDGET */

    .budget-item {
      margin-bottom: 20px;
    }

    .budget-header {
      display: flex;
      justify-content: space-between;
      margin-bottom: 8px;
    }

    .progress {
      width: 100%;
      height: 9px;
      background: #e5e7eb;
      border-radius: 20px;
      overflow: hidden;
    }

    .progress-bar {
      height: 100%;
      background: #16a34a;
      border-radius: 20px;
    }

    .progress-bar.over {
      background: #dc2626;
    }

    /* SEARCH */

    .toolbar {
      display: flex;
      gap: 12px;
      margin-bottom: 18px;
    }

    .toolbar input {
      max-width: 350px;
    }

    /* MODAL */

    .modal {
      display: none;
      position: fixed;
      inset: 0;
      background: rgba(15,23,42,.55);
      align-items: center;
      justify-content: center;
      padding: 20px;
      z-index: 100;
    }

    .modal.show {
      display: flex;
    }

    .modal-content {
      background: white;
      width: 100%;
      max-width: 500px;
      border-radius: 14px;
      padding: 25px;
    }

    .modal-header {
      display: flex;
      justify-content: space-between;
      margin-bottom: 20px;
    }

    .close {
      border: 0;
      background: transparent;
      font-size: 22px;
    }

    /* EMPTY */

    .empty {
      text-align: center;
      color: #94a3b8;
      padding: 30px 10px;
    }

    /* MOBILE */

    @media (max-width: 1000px) {
      .cards {
        grid-template-columns: repeat(2, 1fr);
      }

      .grid {
        grid-template-columns: 1fr;
      }
    }

    @media (max-width: 700px) {
      .sidebar {
        width: 70px;
        padding: 20px 10px;
      }

      .logo {
        font-size: 0;
      }

      .logo span {
        font-size: 24px;
      }

      .nav button {
        text-align: center;
        font-size: 0;
      }

      .nav button::first-letter {
        font-size: 18px;
      }

      .main {
        margin-left: 70px;
        width: calc(100% - 70px);
        padding: 18px;
      }

      .cards {
        grid-template-columns: 1fr;
      }

      .topbar {
        align-items: flex-start;
        gap: 15px;
      }

      .toolbar {
        flex-direction: column;
      }
    }
  </style>
</head>

<body>

<div class="app">

  <!-- SIDEBAR -->

  <aside class="sidebar">

    <div class="logo">
      Money<span>Wise</span>
    </div>

    <nav class="nav">

      <button class="active" onclick="showPage('dashboard', this)">
        🏠 Dashboard
      </button>

      <button onclick="showPage('transactions', this)">
        💳 Transactions
      </button>

      <button onclick="showPage('categories', this)">
        🗂️ Categories
      </button>

      <button onclick="showPage('budgets', this)">
        🎯 Budgets
      </button>

    </nav>

  </aside>

  <!-- MAIN -->

  <main class="main">

    <!-- DASHBOARD -->

    <section id="dashboard" class="page active">

      <div class="topbar">

        <div>
          <h1>Dashboard</h1>
          <p>Here's your financial overview.</p>
        </div>

        <button class="primary-btn" onclick="openTransactionModal()">
          + Add Transaction
        </button>

      </div>

      <div class="cards">

        <div class="card">
          <div class="card-title">Balance</div>
          <div class="card-value balance" id="balance">
            £0.00
          </div>
        </div>

        <div class="card">
          <div class="card-title">Income</div>
          <div class="card-value income" id="income">
            £0.00
          </div>
        </div>

        <div class="card">
          <div class="card-title">Expenses</div>
          <div class="card-value expense" id="expenses">
            £0.00
          </div>
        </div>

        <div class="card">
          <div class="card-title">Transactions</div>
          <div class="card-value" id="transactionCount">
            0
          </div>
        </div>

      </div>

      <div class="grid">

        <div class="panel">

          <div class="panel-header">
            <h2>Recent Transactions</h2>
            <button onclick="showPage('transactions')">
              View all
            </button>
          </div>

          <div id="recentTransactions"></div>

        </div>

        <div class="panel">

          <div class="panel-header">
            <h2>Spending by Category</h2>
          </div>

          <div id="categorySummary"></div>

        </div>

      </div>

    </section>


    <!-- TRANSACTIONS -->

    <section id="transactions" class="page">

      <div class="topbar">

        <div>
          <h1>Transactions</h1>
          <p>Manage your income and expenses.</p>
        </div>

        <button class="primary-btn" onclick="openTransactionModal()">
          + Add Transaction
        </button>

      </div>

      <div class="panel">

        <div class="toolbar">

          <input
            type="text"
            id="searchTransactions"
            placeholder="Search transactions..."
            oninput="renderTransactions()"
          />

          <select id="typeFilter" onchange="renderTransactions()">
            <option value="all">All transactions</option>
            <option value="income">Income</option>
            <option value="expense">Expenses</option>
          </select>

        </div>

        <div id="transactionList"></div>

      </div>

    </section>


    <!-- CATEGORIES -->

    <section id="categories" class="page">

      <div class="topbar">

        <div>
          <h1>Categories</h1>
          <p>Create your own spending categories.</p>
        </div>

      </div>

      <div class="grid">

        <div class="panel">

          <div class="panel-header">
            <h2>Your Categories</h2>
          </div>

          <div id="categoryList" class="category-list"></div>

        </div>

        <div class="panel">

          <div class="panel-header">
            <h2>Add Category</h2>
          </div>

          <form class="form" onsubmit="addCategory(event)">

            <div class="form-group">

              <label>Category name</label>

              <input
                type="text"
                id="categoryName"
                placeholder="e.g. Groceries"
                required
              />

            </div>

            <div class="form-group">

              <label>Icon</label>

              <input
                type="text"
                id="categoryIcon"
                placeholder="e.g. 🛒"
                maxlength="2"
              />

            </div>

            <button class="primary-btn">
              Add Category
            </button>

          </form>

        </div>

      </div>

    </section>


    <!-- BUDGETS -->

    <section id="budgets" class="page">

      <div class="topbar">

        <div>
          <h1>Budgets</h1>
          <p>Set spending limits for your categories.</p>
        </div>

      </div>

      <div class="grid">

        <div class="panel">

          <div class="panel-header">
            <h2>Your Budgets</h2>
          </div>

          <div id="budgetList"></div>

        </div>

        <div class="panel">

          <div class="panel-header">
            <h2>Create Budget</h2>
          </div>

          <form class="form" onsubmit="addBudget(event)">

            <div class="form-group">

              <label>Category</label>

              <select id="budgetCategory"></select>

            </div>

            <div class="form-group">

              <label>Monthly limit</label>

              <input
                type="number"
                id="budgetAmount"
                min="0"
                step="0.01"
                placeholder="500"
                required
              />

            </div>

            <button class="primary-btn">
              Create Budget
            </button>

          </form>

        </div>

      </div>

    </section>

  </main>

</div>


<!-- TRANSACTION MODAL -->

<div class="modal" id="transactionModal">

  <div class="modal-content">

    <div class="modal-header">

      <h2>Add Transaction</h2>

      <button class="close" onclick="closeTransactionModal()">
        ×
      </button>

    </div>

    <form class="form" onsubmit="addTransaction(event)">

      <div class="form-group">

        <label>Transaction type</label>

        <select id="transactionType" required>

          <option value="expense">
            Expense
          </option>

          <option value="income">
            Income
          </option>

        </select>

      </div>

      <div class="form-group">

        <label>Description</label>

        <input
          type="text"
          id="transactionDescription"
          placeholder="e.g. Weekly groceries"
          required
        />

      </div>

      <div class="form-group">

        <label>Amount (£)</label>

        <input
          type="number"
          id="transactionAmount"
          min="0"
          step="0.01"
          placeholder="25.50"
          required
        />

      </div>

      <div class="form-group">

        <label>Category</label>

        <select id="transactionCategory" required></select>

      </div>

      <div class="form-group">

        <label>Date</label>

        <input
          type="date"
          id="transactionDate"
          required
        />

      </div>

      <button class="primary-btn">
        Add Transaction
      </button>

    </form>

  </div>

</div>


<script>

/* ==============================
   DATA
================================ */

const defaultCategories = [
  {
    id: crypto.randomUUID(),
    name: "Food",
    icon: "🍔"
  },
  {
    id: crypto.randomUUID(),
    name: "Transport",
    icon: "🚗"
  },
  {
    id: crypto.randomUUID(),
    name: "Bills",
    icon: "💡"
  },
  {
    id: crypto.randomUUID(),
    name: "Entertainment",
    icon: "🎮"
  },
  {
    id: crypto.randomUUID(),
    name: "Shopping",
    icon: "🛍️"
  }
];

let categories =
  JSON.parse(localStorage.getItem("categories")) ||
  defaultCategories;

let transactions =
  JSON.parse(localStorage.getItem("transactions")) ||
  [];

let budgets =
  JSON.parse(localStorage.getItem("budgets")) ||
  [];


/* ==============================
   SAVE DATA
================================ */

function saveData() {

  localStorage.setItem(
    "categories",
    JSON.stringify(categories)
  );

  localStorage.setItem(
    "transactions",
    JSON.stringify(transactions)
  );

  localStorage.setItem(
    "budgets",
    JSON.stringify(budgets)
  );
}


/* ==============================
   NAVIGATION
================================ */

function showPage(pageId, button) {

  document.querySelectorAll(".page")
    .forEach(page => page.classList.remove("active"));

  document.getElementById(pageId)
    .classList.add("active");

  document.querySelectorAll(".nav button")
    .forEach(btn => btn.classList.remove("active"));

  if (button) {
    button.classList.add("active");
  }

  if (pageId === "dashboard") {
    renderDashboard();
  }

  if (pageId === "transactions") {
    renderTransactions();
  }

  if (pageId === "categories") {
    renderCategories();
  }

  if (pageId === "budgets") {
    renderBudgets();
  }
}


/* ==============================
   TRANSACTION MODAL
================================ */

function openTransactionModal() {

  populateCategorySelect(
    document.getElementById("transactionCategory")
  );

  document.getElementById("transactionDate").value =
    new Date().toISOString().split("T")[0];

  document
    .getElementById("transactionModal")
    .classList.add("show");
}


function closeTransactionModal() {

  document
    .getElementById("transactionModal")
    .classList.remove("show");
}


/* ==============================
   ADD TRANSACTION
================================ */

function addTransaction(event) {

  event.preventDefault();

  const type =
    document.getElementById("transactionType").value;

  const description =
    document.getElementById("transactionDescription").value;

  const amount =
    Number(document.getElementById("transactionAmount").value);

  const categoryId =
    document.getElementById("transactionCategory").value;

  const date =
    document.getElementById("transactionDate").value;

  transactions.unshift({

    id: crypto.randomUUID(),

    type,

    description,

    amount,

    categoryId,

    date

  });

  saveData();

  event.target.reset();

  closeTransactionModal();

  renderDashboard();
  renderTransactions();
}


/* ==============================
   DELETE TRANSACTION
================================ */

function deleteTransaction(id) {

  transactions =
    transactions.filter(
      transaction => transaction.id !== id
    );

  saveData();

  renderDashboard();
  renderTransactions();
}


/* ==============================
   ADD CATEGORY
================================ */

function addCategory(event) {

  event.preventDefault();

  const name =
    document.getElementById("categoryName").value.trim();

  const icon =
    document.getElementById("categoryIcon").value.trim()
    || "📁";

  if (!name) return;

  categories.push({

    id: crypto.randomUUID(),

    name,

    icon

  });

  saveData();

  event.target.reset();

  renderCategories();

  populateAllCategorySelects();
}


/* ==============================
   DELETE CATEGORY
================================ */

function deleteCategory(id) {

  const used =
    transactions.some(
      transaction => transaction.categoryId === id
    );

  if (used) {

    alert(
      "This category is being used by a transaction and cannot be deleted."
    );

    return;
  }

  categories =
    categories.filter(category => category.id !== id);

  budgets =
    budgets.filter(budget => budget.categoryId !== id);

  saveData();

  renderCategories();
  renderBudgets();

  populateAllCategorySelects();
}


/* ==============================
   CATEGORIES
================================ */

function renderCategories() {

  const container =
    document.getElementById("categoryList");

  if (categories.length === 0) {

    container.innerHTML =
      `<div class="empty">No categories yet.</div>`;

    return;
  }

  container.innerHTML =
    categories.map(category => `

      <div class="category-item">

        <div class="category-info">

          <div class="category-icon">
            ${category.icon}
          </div>

          <strong>
            ${escapeHTML(category.name)}
          </strong>

        </div>

        <button
          class="delete-btn"
          onclick="deleteCategory('${category.id}')"
        >
          Delete
        </button>

      </div>

    `).join("");
}


/* ==============================
   CATEGORY SELECTS
================================ */

function populateCategorySelect(select) {

  select.innerHTML =
    categories.map(category => `

      <option value="${category.id}">
        ${category.icon} ${escapeHTML(category.name)}
      </option>

    `).join("");
}


function populateAllCategorySelects() {

  const transactionSelect =
    document.getElementById("transactionCategory");

  const budgetSelect =
    document.getElementById("budgetCategory");

  if (transactionSelect) {
    populateCategorySelect(transactionSelect);
  }

  if (budgetSelect) {
    populateCategorySelect(budgetSelect);
  }
}


/* ==============================
   DASHBOARD
================================ */

function renderDashboard() {

  let income = 0;
  let expenses = 0;

  transactions.forEach(transaction => {

    if (transaction.type === "income") {
      income += transaction.amount;
    } else {
      expenses += transaction.amount;
    }

  });

  const balance = income - expenses;

  document.getElementById("balance")
    .textContent = formatMoney(balance);

  document.getElementById("income")
    .textContent = formatMoney(income);

  document.getElementById("expenses")
    .textContent = formatMoney(expenses);

  document.getElementById("transactionCount")
    .textContent = transactions.length;

  renderRecentTransactions();

  renderCategorySummary();
}


/* ==============================
   RECENT TRANSACTIONS
================================ */

function renderRecentTransactions() {

  const container =
    document.getElementById("recentTransactions");

  const recent =
    transactions.slice(0, 6);

  if (recent.length === 0) {

    container.innerHTML =
      `<div class="empty">
        No transactions yet.
      </div>`;

    return;
  }

  container.innerHTML =
    recent.map(createTransactionHTML).join("");
}


/* ==============================
   TRANSACTION LIST
================================ */

function renderTransactions() {

  const container =
    document.getElementById("transactionList");

  const search =
    document.getElementById("searchTransactions")
      ?.value
      .toLowerCase() || "";

  const filter =
    document.getElementById("typeFilter")
      ?.value || "all";

  let filtered =
    transactions.filter(transaction => {

      const matchesSearch =
        transaction.description
          .toLowerCase()
          .includes(search);

      const matchesFilter =
        filter === "all" ||
        transaction.type === filter;

      return matchesSearch && matchesFilter;

    });

  if (filtered.length === 0) {

    container.innerHTML =
      `<div class="empty">
        No transactions found.
      </div>`;

    return;
  }

  container.innerHTML =
    filtered.map(transaction => `

      <div class="transaction">

        ${createTransactionHTML(transaction, false)}

      </div>

    `).join("");
}


/* ==============================
   TRANSACTION HTML
================================ */

function createTransactionHTML(
  transaction,
  showDelete = true
) {

  const category =
    categories.find(
      category =>
        category.id === transaction.categoryId
    );

  const sign =
    transaction.type === "income"
      ? "+"
      : "-";

  const color =
    transaction.type === "income"
      ? "income"
      : "expense";

  return `

    <div class="transaction-left">

      <div class="category-icon">
        ${category?.icon || "📁"}
      </div>

      <div>

        <div class="transaction-name">
          ${escapeHTML(transaction.description)}
        </div>

        <div class="transaction-category">
          ${category?.name || "Uncategorized"}
          • ${formatDate(transaction.date)}
        </div>

      </div>

    </div>

    <div>

      <span class="amount ${color}">
        ${sign}${formatMoney(transaction.amount)}
      </span>

      ${
        showDelete
        ? `
          <button
            class="delete-btn"
            style="margin-left:15px"
            onclick="deleteTransaction('${transaction.id}')"
          >
            Delete
          </button>
        `
        : ""
      }

    </div>

  `;
}


/* ==============================
   CATEGORY SUMMARY
================================ */

function renderCategorySummary() {

  const container =
    document.getElementById("categorySummary");

  const spending = {};

  transactions
    .filter(transaction => transaction.type === "expense")
    .forEach(transaction => {

      spending[transaction.categoryId] =
        (spending[transaction.categoryId] || 0)
        + transaction.amount;

    });

  const results =
    Object.entries(spending)
      .sort((a,b) => b[1] - a[1])
      .slice(0, 6);

  if (results.length === 0) {

    container.innerHTML =
      `<div class="empty">
        No spending data yet.
      </div>`;

    return;
  }

  const max =
    Math.max(...results.map(item => item[1]));

  container.innerHTML =
    results.map(([categoryId, amount]) => {

      const category =
        categories.find(
          category => category.id === categoryId
        );

      const percentage =
        (amount / max) * 100;

      return `

        <div class="budget-item">

          <div class="budget-header">

            <span>
              ${category?.icon || "📁"}
              ${category?.name || "Other"}
            </span>

            <strong>
              ${formatMoney(amount)}
            </strong>

          </div>

          <div class="progress">

            <div
              class="progress-bar"
              style="width:${percentage}%"
            ></div>

          </div>

        </div>

      `;

    }).join("");
}


/* ==============================
   BUDGETS
================================ */

function addBudget(event) {

  event.preventDefault();

  const categoryId =
    document.getElementById("budgetCategory").value;

  const amount =
    Number(document.getElementById("budgetAmount").value);

  const existing =
    budgets.find(
      budget => budget.categoryId === categoryId
    );

  if (existing) {

    existing.amount = amount;

  } else {

    budgets.push({

      id: crypto.randomUUID(),

      categoryId,

      amount

    });

  }

  saveData();

  event.target.reset();

  renderBudgets();
}


function renderBudgets() {

  const container =
    document.getElementById("budgetList");

  if (budgets.length === 0) {

    container.innerHTML =
      `<div class="empty">
        No budgets created yet.
      </div>`;

    return;
  }

  container.innerHTML =
    budgets.map(budget => {

      const category =
        categories.find(
          category =>
            category.id === budget.categoryId
        );

      const spent =
        transactions
          .filter(transaction =>
            transaction.categoryId === budget.categoryId &&
            transaction.type === "expense"
          )
          .reduce(
            (total, transaction) =>
              total + transaction.amount,
            0
          );

      const percentage =
        Math.min(
          (spent / budget.amount) * 100,
          100
        );

      const over =
        spent > budget.amount;

      return `

        <div class="budget-item">

          <div class="budget-header">

            <span>
              ${category?.icon || "📁"}
              ${category?.name || "Unknown"}
            </span>

            <span>
              ${formatMoney(spent)}
              /
              ${formatMoney(budget.amount)}
            </span>

          </div>

          <div class="progress">

            <div
              class="progress-bar ${over ? "over" : ""}"
              style="width:${percentage}%"
            ></div>

          </div>

          <div style="
            margin-top:7px;
            font-size:12px;
            color:#64748b;
          ">

            ${
              over
                ? "Over budget"
                : formatMoney(budget.amount - spent)
                  + " remaining"
            }

          </div>

        </div>

      `;

    }).join("");
}


/* ==============================
   HELPERS
================================ */

function formatMoney(amount) {

  return new Intl.NumberFormat(
    "en-GB",
    {
      style: "currency",
      currency: "GBP"
    }
  ).format(amount);

}


function formatDate(date) {

  return new Date(date).toLocaleDateString(
    "en-GB",
    {
      day: "numeric",
      month: "short",
      year: "numeric"
    }
  );

}


function escapeHTML(value) {

  return String(value)
    .replaceAll("&", "&amp;")
    .replaceAll("<", "&lt;")
    .replaceAll(">", "&gt;")
    .replaceAll('"', "&quot;")
    .replaceAll("'", "&#039;");

}


/* ==============================
   INITIALIZE
================================ */

populateAllCategorySelects();

renderDashboard();

renderTransactions();

renderCategories();

renderBudgets();

</script>

