}


function clearAuthMessage() {

  const element =
    document.getElementById("authMessage");


  element.textContent = "";

  element.className =
    "message";

}


function showAppMessage(
  message,
  type
) {

  const element =
    document.getElementById("appMessage");


  element.textContent =
    message;


  element.className =
    "message " + type;


  /*
    Automatically remove the message
    after a few seconds.
  */

  setTimeout(function() {

    element.textContent = "";

    element.className =
      "message";

  }, 4000);

}

