<!-- LOGIN SCREEN -->

<div id="authScreen" class="auth-screen">

  <div class="auth-card">

    <div class="auth-logo">
      <div class="logo-icon">P</div>
      <span>PennyPilot</span>
    </div>

    <div class="auth-header">
      <h1 id="authTitle">Welcome back</h1>
      <p id="authSubtitle">
        Sign in to continue to your finances.
      </p>
    </div>

    <form id="authForm">

      <div class="field">
        <label>Email address</label>

        <input
          id="authEmail"
          type="email"
          placeholder="you@example.com"
          required
        />
      </div>

      <div class="field">
        <label>Password</label>

        <input
          id="authPassword"
          type="password"
          placeholder="Enter your password"
          minlength="6"
          required
        />
      </div>

      <div
        id="authError"
        class="auth-error"
      ></div>

      <button
        type="submit"
        class="auth-submit"
      >
        Sign in
      </button>

    </form>

    <div class="auth-switch">

      <span id="authSwitchText">
        Don't have an account?
      </span>

      <button
        type="button"
        onclick="toggleAuthMode()"
        id="authSwitchButton"
      >
        Create account
      </button>

    </div>

  </div>

</div>

/* =========================
   AUTHENTICATION
========================= */

.auth-screen {
  position: fixed;
  inset: 0;
  background:
    radial-gradient(
      circle at top right,
      #dcefdc,
      transparent 35%
    ),
    #f5f7f4;

  display: flex;
  justify-content: center;
  align-items: center;

  padding: 20px;

  z-index: 1000;
}

.auth-screen.hidden {
  display: none;
}

.auth-card {
  width: 100%;
  max-width: 420px;

  background: white;

  padding: 35px;

  border-radius: 25px;

  border: 1px solid #e2e9e3;

  box-shadow:
    0 25px 70px
    rgba(18, 61, 42, .12);
}

.auth-logo {
  display: flex;
  justify-content: center;
  align-items: center;

  gap: 10px;

  font-size: 24px;
  font-weight: 800;

  margin-bottom: 35px;
}

.auth-logo .logo-icon {
  width: 36px;
  height: 36px;

  border-radius: 11px;

  display: grid;
  place-items: center;

  background: #dff2a8;
  color: #123d2a;
}

.auth-header {
  text-align: center;

  margin-bottom: 28px;
}

.auth-header h1 {
  margin: 0 0 8px;

  font-size: 27px;

  letter-spacing: -.03em;
}

.auth-header p {
  margin: 0;

  color: #77827b;

  font-size: 14px;
}

.auth-submit {
  width: 100%;

  padding: 14px;

  border: 0;

  border-radius: 12px;

  background: #123d2a;

  color: white;

  font-weight: 800;

  margin-top: 5px;

  transition: .2s;
}

.auth-submit:hover {
  background: #1f6545;
  transform: translateY(-1px);
}

.auth-switch {
  display: flex;

  justify-content: center;

  gap: 5px;

  margin-top: 22px;

  font-size: 13px;

  color: #77827b;
}

.auth-switch button {
  border: 0;

  background: transparent;

  color: #1f6545;

  font-weight: 800;

  cursor: pointer;
}

.auth-error {
  color: #c95f5f;

  font-size: 12px;

  margin-bottom: 12px;

  min-height: 16px;
}
/* =========================
   AUTHENTICATION
========================= */

let authMode = "login";


/*
  Check whether someone is already
  signed in when the page loads.
*/

function checkAuthentication() {

  const user =
    localStorage.getItem(
      "pennypilot_user"
    );

  if (user) {

    showDashboard();

  } else {

    showLogin();

  }

}


/*
  Show login screen
*/

function showLogin() {

  document
    .getElementById("authScreen")
    .classList.remove("hidden");

  document
    .querySelector(".app")
    .style.display = "none";

}


/*
  Show dashboard
*/

function showDashboard() {

  document
    .getElementById("authScreen")
    .classList.add("hidden");

  document
    .querySelector(".app")
    .style.display = "flex";

}


/*
  Toggle between:

  Sign in
  Create account
*/

function toggleAuthMode() {

  const title =
    document.getElementById(
      "authTitle"
    );

  const subtitle =
    document.getElementById(
      "authSubtitle"
    );

  const submit =
    document.querySelector(
      ".auth-submit"
    );

  const switchText =
    document.getElementById(
      "authSwitchText"
    );

  const switchButton =
    document.getElementById(
      "authSwitchButton"
    );


  if (authMode === "login") {

    authMode = "signup";

    title.textContent =
      "Create your account";

    subtitle.textContent =
      "Start taking control of your money.";

    submit.textContent =
      "Create account";

    switchText.textContent =
      "Already have an account?";

    switchButton.textContent =
      "Sign in";

  } else {

    authMode = "login";

    title.textContent =
      "Welcome back";

    subtitle.textContent =
      "Sign in to continue to your finances.";

    submit.textContent =
      "Sign in";

    switchText.textContent =
      "Don't have an account?";

    switchButton.textContent =
      "Create account";

  }

}


/*
  Handle login/signup
*/

document
  .getElementById("authForm")
  .addEventListener(
    "submit",
    function(event) {

      event.preventDefault();


      const email =
        document
          .getElementById("authEmail")
          .value
          .trim()
          .toLowerCase();


      const password =
        document
          .getElementById("authPassword")
          .value;


      const error =
        document.getElementById(
          "authError"
        );


      error.textContent = "";


      if (!email) {

        error.textContent =
          "Please enter your email.";

        return;

      }


      if (password.length < 6) {

        error.textContent =
          "Password must contain at least 6 characters.";

        return;

      }


      /*
        DEMO AUTHENTICATION

        This is intentionally simple for
        the prototype.

        DO NOT store real passwords this way
        in a production application.
      */

      const storedUser =
        JSON.parse(
          localStorage.getItem(
            "pennypilot_account"
          )
        );


      if (authMode === "signup") {

        if (storedUser) {

          error.textContent =
            "An account already exists. Please sign in.";

          return;

        }


        const account = {

          email: email,

          /*
            Demo only.

            A production application should
            NEVER store a plain-text password.
          */

          password: password

        };


        localStorage.setItem(
          "pennypilot_account",
          JSON.stringify(account)
        );


        localStorage.setItem(
          "pennypilot_user",
          email
        );


        showDashboard();

        showToast(
          "Welcome to PennyPilot!"
        );

      }

      else {

        if (!storedUser) {

          error.textContent =
            "No account found. Create an account first.";

          return;

        }


        if (
          storedUser.email !== email ||
          storedUser.password !== password
        ) {

          error.textContent =
            "Incorrect email or password.";

          return;

        }


        localStorage.setItem(
          "pennypilot_user",
          email
        );


        showDashboard();

        showToast(
          "Welcome back!"
        );

      }

    }
  );


/*
  LOGOUT
*/

function logout() {

  localStorage.removeItem(
    "pennypilot_user"
  );

  showLogin();

}


/*
  Start authentication check
*/

checkAuthentication();

<button
  onclick="logout()"
  style="
    margin-top:25px;
    width:100%;
    border:0;
    background:transparent;
    color:#bfd0c6;
    padding:13px;
    border-radius:12px;
    text-align:left;
    cursor:pointer;
  "
>

  <span>Log out</span>
</button>
