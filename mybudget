const SUPABASE_KEY = "sb_publishable_o0AQq3DS5Cm1g3KjD2vqpw_jQLyQeF6";


/* Create Supabase client */

const { createClient } = supabase;

const db = createClient(
  SUPABASE_URL,
  SUPABASE_KEY
);


/* =========================================================
   APPLICATION VARIABLES
   ========================================================= */

let currentUser = null;

let transactions = [];

let editingId = null;

let authMode = "signin";


/* =========================================================
   PAGE STARTUP
   ========================================================= */

document.addEventListener("DOMContentLoaded", async function() {

  /*
    Set today's date automatically.
  */

  document.getElementById("transactionDate").value =
    getToday();

  /*
    Check whether a user is already logged in.
  */

  const { data, error } = await db.auth.getSession();

  if (error) {
    console.error(error);
    showAuthMessage(
      "Unable to check your login.",
      "error"
    );
    return;
  }

  if (data.session) {

    currentUser = data.session.user;

    await showApp();

  } else {

    showLogin();

  }


  /*
    Listen for login/logout changes.
  */

  db.auth.onAuthStateChange(
    async function(event, session) {

      if (session) {

        currentUser = session.user;

        await showApp();

      } else {

        currentUser = null;

        transactions = [];

        showLogin();

      }

    }
  );

});


/* =========================================================
   AUTHENTICATION
   ========================================================= */


/*
  Switch between Sign In and Create Account.
*/

function toggleAuthMode() {

  clearAuthMessage();

  if (authMode === "signin") {

    authMode = "signup";

    document.getElementById("authTitle").textContent =
      "Create Account";

    document.getElementById("authButton").textContent =
      "Create Account";

    document.getElementById("toggleAuthButton").textContent =
      "Back to Sign In";

    document.getElementById("authHelp").textContent =
      "Create an account to keep your budget private.";

  } else {

    authMode = "signin";

    document.getElementById("authTitle").textContent =
      "Sign In";

    document.getElementById("authButton").textContent =
      "Sign In";

    document.getElementById("toggleAuthButton").textContent =
      "Create account";

    document.getElementById("authHelp").textContent =
      "Sign in to access your private budget.";

  }

}


/*
  Handle either Sign In or Create Account.
*/

async function handleAuth() {

  clearAuthMessage();

  const email =
    document.getElementById("email").value.trim();

  const password =
    document.getElementById("password").value;


  if (!email) {

    showAuthMessage(
      "Please enter your email address.",
      "error"
    );

    return;
  }


  if (!password) {

    showAuthMessage(
      "Please enter your password.",
      "error"
    );

    return;
  }


  if (password.length < 6) {

    showAuthMessage(
      "Your password must be at least 6 characters.",
      "error"
    );

    return;
  }


  const button =
    document.getElementById("authButton");

  button.disabled = true;


  try {

    if (authMode === "signin") {

      /*
        SIGN IN
      */

      const { data, error } =
        await db.auth.signInWithPassword({
          email: email,
          password: password
        });


      if (error) {
        throw error;
      }


      currentUser = data.user;

      showAuthMessage(
        "Signed in successfully.",
        "success"
      );


      /*
        The auth listener will also show the app.
      */

    } else {

      /*
        CREATE ACCOUNT
      */

      const { data, error } =
        await db.auth.signUp({
          email: email,
          password: password
        });


      if (error) {
        throw error;
      }


      /*
        Supabase may require email confirmation.
      */

      if (data.session) {

        currentUser = data.user;

        showAuthMessage(
          "Account created successfully.",
          "success"
        );

      } else {

        showAuthMessage(
          "Account created. Please check your email and confirm your account before signing in.",
          "success"
        );

      }

    }

  } catch (error) {

    console.error(error);

    showAuthMessage(
      getAuthErrorMessage(error),
      "error"
    );

  } finally {

    button.disabled = false;

  }

}


/*
  Convert common Supabase authentication errors
  into friendlier messages.
*/

function getAuthErrorMessage(error) {

  const message =
    error?.message || "Something went wrong.";

  if (
    message.toLowerCase().includes("invalid login")
  ) {
    return "The email or password is incorrect.";
  }

  if (
    message.toLowerCase().includes("already registered")
  ) {
    return "An account with this email already exists.";
  }

  if (
    message.toLowerCase().includes("user already registered")
  ) {
    return "An account with this email already exists.";
  }

  if (
    message.toLowerCase().includes("password should be at least")
  ) {
    return "Your password must be at least 6 characters.";
  }

  return message;

}


/*
  Log out.
*/

async function logout() {

  const { error } = await db.auth.signOut();

  if (error) {

    console.error(error);

    showAppMessage(
      "Unable to log out. Please try again.",
      "error"
    );

  }

}


/* =========================================================
   SHOW / HIDE LOGIN AND APP
   ========================================================= */

function showLogin() {

  document
    .getElementById("authSection")
    .classList.remove("hidden");

  document
    .getElementById("appSection")
    .classList.add("hidden");

}


async function showApp() {

  document
    .getElementById("authSection")
    .classList.add("hidden");

  document
    .getElementById("appSection")
    .classList.remove("hidden");


  if (currentUser) {

    document.getElementById("loggedInUser").textContent =
      currentUser.email || "";

  }


  await loadTransactions();

}


/* =========================================================
   DATABASE
   ========================================================= */


/*
  Load ONLY the current user's transactions.

  Supabase Row Level Security also protects this data
  at the database level.
*/

async function loadTransactions() {

  if (!currentUser) {
    return;
  }


  document
    .getElementById("loading")
    .classList.remove("hidden");


  const { data, error } = await db
    .from("transactions")
    .select("*")
    .eq("user_id", currentUser.id)
    .order("transaction_date", {
      ascending: false
    })
    .order("id", {
      ascending: false
    });


  document
    .getElementById("loading")
    .classList.add("hidden");


  if (error) {

    console.error(error);

    showAppMessage(
      "Could not load your transactions: " +
      error.message,
      "error"
    );

    return;
  }


  transactions = data || [];

  renderAll();

}


/*
  Add or update a transaction.
*/

async function saveTransaction() {

  if (!currentUser) {

    showAppMessage(
      "Please sign in first.",
      "error"
    );

    return;
  }


  const title =
    document.getElementById("title").value.trim();

  const amount =
    parseFloat(
      document.getElementById("amount").value
    );

  const type =
    document.getElementById("type").value;

  const category =
    document.getElementById("category").value;

  const transactionDate =
    document.getElementById("transactionDate").value;


  if (!title) {

    showAppMessage(
      "Please enter a title.",
      "error"
    );

    return;
  }


  if (
    isNaN(amount) ||
    amount <= 0
  ) {

    showAppMessage(
      "Please enter a valid amount.",
      "error"
    );

    return;
  }


  if (!transactionDate) {

    showAppMessage(
      "Please select a date.",
      "error"
    );

    return;
  }


  const transactionData = {

    user_id: currentUser.id,

    description: title,

    amount: amount.toFixed(2),

    type: type,

    category: category,

    transaction_date: transactionDate

  };


  const saveButton =
    document.getElementById("saveButton");

  saveButton.disabled = true;


  try {

    if (editingId) {

      /*
        UPDATE
      */

      const { error } =
        await db
          .from("transactions")
          .update({
            description: title,
            amount: amount.toFixed(2),
            type: type,
            category: category,
            transaction_date: transactionDate
          })
          .eq("id", editingId)
          .eq("user_id", currentUser.id);


      if (error) {
        throw error;
      }


      showAppMessage(
        "Transaction updated successfully.",
        "success"
      );


    } else {

      /*
        INSERT
      */

      const { error } =
        await db
          .from("transactions")
          .insert(transactionData);


      if (error) {
        throw error;
      }


      showAppMessage(
        "Transaction added successfully.",
        "success"
      );

    }


    editingId = null;

    resetTransactionForm();

    await loadTransactions();


  } catch (error) {

    console.error(error);

    showAppMessage(
      "Could not save transaction: " +
      error.message,
      "error"
    );

  } finally {

    saveButton.disabled = false;

  }

}


/*
  Delete a transaction.
*/

async function deleteTransaction(id) {

  if (!currentUser) {
    return;
  }


  const confirmed =
    confirm(
      "Are you sure you want to delete this transaction?"
    );


  if (!confirmed) {
    return;
  }


  const { error } =
    await db
      .from("transactions")
      .delete()
      .eq("id", id)
      .eq("user_id", currentUser.id);


  if (error) {

    console.error(error);

    showAppMessage(
      "Could not delete transaction: " +
      error.message,
      "error"
    );

    return;
  }


  showAppMessage(
    "Transaction deleted.",
    "success"
  );


  await loadTransactions();

}


/*
  Begin editing a transaction.
*/

function editTransaction(id) {

  const transaction =
    transactions.find(
      item => String(item.id) === String(id)
    );


  if (!transaction) {
    return;
  }


  editingId = transaction.id;


  document.getElementById("title").value =
    transaction.description || "";

  document.getElementById("amount").value =
    transaction.amount || "";

  document.getElementById("type").value =
    transaction.type || "Expense";

  document.getElementById("category").value =
    transaction.category || "Miscellaneous";

  document.getElementById("transactionDate").value =
    transaction.transaction_date || "";


  document.getElementById("formTitle").textContent =
    "Edit Transaction";

  document.getElementById("saveButton").textContent =
    "Update Transaction";

  document
    .getElementById("cancelEditButton")
    .classList.remove("hidden");


  window.scrollTo({
    top: 0,
    behavior: "smooth"
  });

}


/*
  Cancel editing.
*/

function cancelEdit() {

  editingId = null;

  resetTransactionForm();

}


/*
  Reset the transaction form.
*/

function resetTransactionForm() {

  document.getElementById("title").value = "";

  document.getElementById("amount").value = "";

  document.getElementById("type").value =
    "Income";

  document.getElementById("category").value =
    "Salary";

  document.getElementById("transactionDate").value =
    getToday();

  document.getElementById("formTitle").textContent =
    "Add Transaction";

  document.getElementById("saveButton").textContent =
    "Add Transaction";

  document
    .getElementById("cancelEditButton")
    .classList.add("hidden");

}


/* =========================================================
   DISPLAY / CALCULATIONS
   ========================================================= */

function renderAll() {

  renderSummary();

  renderTransactions();

}


/*
  Get transactions after applying month filter.
*/

function getFilteredTransactions() {

  const month =
    document.getElementById("monthFilter").value;


  if (!month) {
    return transactions;
  }


  return transactions.filter(function(transaction) {

    return transaction.transaction_date
      .startsWith(month);

  });

}


/*
  Calculate income, expenses and balance.
*/

function renderSummary() {

  const filtered =
    getFilteredTransactions();


  let income = 0;

  let expenses = 0;


  filtered.forEach(function(transaction) {

    const amount =
      parseFloat(transaction.amount) || 0;


    if (transaction.type === "Income") {

      income += amount;

    } else {

      expenses += amount;

    }

  });


  const balance =
    income - expenses;


  document.getElementById("totalIncome").textContent =
    formatGBP(income);

  document.getElementById("totalExpenses").textContent =
    formatGBP(expenses);

  document.getElementById("balance").textContent =
    formatGBP(balance);

}


/*
  Display transaction table.
*/

function renderTransactions() {

  const table =
    document.getElementById("transactionTable");


  table.innerHTML = "";


  const filtered =
    getFilteredTransactions();


  if (filtered.length === 0) {

    const row =
      document.createElement("tr");

    row.innerHTML = `
      <td colspan="6" class="empty">
        No transactions found.
      </td>
    `;

    table.appendChild(row);

    return;
  }


  filtered.forEach(function(transaction) {

    const row =
      document.createElement("tr");


    const amount =
      parseFloat(transaction.amount) || 0;


    const amountClass =
      transaction.type === "Income"
        ? "amount-income"
        : "amount-expense";


    const sign =
      transaction.type === "Income"
        ? "+"
        : "-";


    row.innerHTML = `

      <td>
        ${escapeHTML(
          formatDate(transaction.transaction_date)
        )}
      </td>

      <td>
        ${escapeHTML(
          transaction.description
        )}
      </td>

      <td>
        ${escapeHTML(
          transaction.type
        )}
      </td>

      <td>
        ${escapeHTML(
          transaction.category
        )}
      </td>

      <td class="${amountClass}">
        ${sign}${formatGBP(amount)}
      </td>

      <td>

        <button
          class="small warning"
          onclick="editTransaction(${transaction.id})"
        >
          Edit
        </button>

        <button
          class="small danger"
          onclick="deleteTransaction(${transaction.id})"
        >
          Delete
        </button>

      </td>

    `;


    table.appendChild(row);

  });

}


