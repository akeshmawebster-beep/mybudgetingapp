<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Luma — Money, made clear.</title>
<style>
:root{
  --bg:#f5f7f3;--panel:#fff;--ink:#17211b;--muted:#748078;--line:#e6ebe6;
  --green:#173f2c;--mint:#cfe9d6;--lime:#dff1a8;--orange:#f4c58b;--red:#e7a4a4;
  --shadow:0 12px 35px rgba(20,45,31,.07);--radius:22px;
}
*{box-sizing:border-box} body{margin:0;font-family:Inter,ui-sans-serif,system-ui,-apple-system,Segoe UI,sans-serif;background:var(--bg);color:var(--ink)}
button,input{font:inherit} button{cursor:pointer;border:0}
.app{display:flex;min-height:100vh}.sidebar{width:245px;background:#102d20;color:#dce9df;padding:25px 16px;position:fixed;inset:0 auto 0 0}
.logo{display:flex;align-items:center;gap:10px;font-weight:800;font-size:22px;padding:4px 10px 30px}.logo-dot{width:30px;height:30px;border-radius:10px;background:var(--lime);display:grid;place-items:center;color:var(--green);font-weight:900}
.nav{display:grid;gap:6px}.nav button{background:transparent;color:#b7cabe;text-align:left;padding:12px 14px;border-radius:12px;display:flex;gap:12px;align-items:center}.nav button.active,.nav button:hover{background:#234a37;color:white}
.bottom{position:absolute;bottom:22px;left:16px;right:16px;background:#183b2a;border-radius:16px;padding:15px;color:#d9e8dd;font-size:12px}.bottom b{display:block;font-size:13px;margin-bottom:5px}
main{margin-left:245px;width:calc(100% - 245px);padding:32px 38px 50px;max-width:1450px}.top{display:flex;justify-content:space-between;align-items:center;margin-bottom:28px}.eyebrow{font-size:12px;color:var(--muted);font-weight:700;text-transform:uppercase;letter-spacing:.09em}.top h1{margin:5px 0 0;font-size:30px;letter-spacing:-.03em}.user{display:flex;align-items:center;gap:10px}.avatar{width:40px;height:40px;border-radius:50%;background:#c9dfcf;display:grid;place-items:center;font-weight:800}
.grid{display:grid;grid-template-columns:1.25fr .75fr;gap:20px}.card{background:var(--panel);border:1px solid var(--line);border-radius:var(--radius);box-shadow:var(--shadow);padding:24px}.hero{background:var(--green);color:white;border:0;min-height:230px;position:relative;overflow:hidden}.hero:after{content:"";position:absolute;width:220px;height:220px;border-radius:50%;background:#2e6248;right:-60px;top:-65px;opacity:.5}.hero .label{color:#bcd2c3}.safe{font-size:48px;font-weight:800;letter-spacing:-.04em;margin:10px 0 4px}.safe-sub{color:#bfd1c4}.hero-actions{display:flex;gap:10px;margin-top:24px}.btn{padding:11px 15px;border-radius:12px;font-weight:750}.btn-light{background:white;color:var(--green)}.btn-ghost{background:#2a503c;color:white}
.card-title{display:flex;justify-content:space-between;align-items:center;margin-bottom:18px}.card-title h2{font-size:17px;margin:0}.link{color:#54705d;font-size:13px;font-weight:700;background:none}
.bars{display:flex;align-items:end;height:135px;gap:12px;padding-top:10px}.bar-wrap{flex:1;text-align:center;font-size:11px;color:var(--muted)}.bar{height:80px;background:#d6e7db;border-radius:8px 8px 4px 4px;margin:0 auto 7px;width:100%;max-width:34px}.bar.highlight{background:#6fa07e}.bar.tall{height:112px}.bar.med{height:95px}.bar.low{height:65px}
.split{display:grid;grid-template-columns:1fr 1fr;gap:20px;margin-top:20px}.budget-row{margin:15px 0}.budget-top{display:flex;justify-content:space-between;font-size:13px;margin-bottom:7px}.track{height:8px;background:#edf1ed;border-radius:99px;overflow:hidden}.fill{height:100%;border-radius:99px;background:#6c9c79}.fill.orange{background:#d99c4d}.fill.red{background:#cc7777}.pill{font-size:11px;padding:4px 8px;background:#edf4ee;border-radius:20px;color:#55715d}
.txn{display:flex;align-items:center;gap:12px;padding:13px 0;border-bottom:1px solid var(--line)}.txn:last-child{border:0}.merchant-icon{width:38px;height:38px;border-radius:12px;background:#eef3ee;display:grid;place-items:center;font-weight:800;color:#42624d}.txn-main{flex:1}.txn-main b{font-size:13px;display:block}.txn-main span{font-size:11px;color:var(--muted)}.amount{font-weight:800;font-size:13px}.negative{color:#26352d}.positive{color:#4e8a5d}
.goal{display:flex;gap:15px;align-items:center}.ring{width:72px;height:72px;border-radius:50%;background:conic-gradient(#6b9b78 0 68%,#e9eee9 68%);display:grid;place-items:center;position:relative}.ring:after{content:"";width:56px;height:56px;background:white;border-radius:50%;position:absolute}.ring span{position:relative;z-index:1;font-size:13px;font-weight:800}.goal b{display:block;margin-bottom:4px}.goal small{color:var(--muted)}
.insight{background:#f1f6ee;border:1px solid #dfebdd;border-radius:15px;padding:14px;margin-top:12px;font-size:13px;line-height:1.45}.insight strong{display:block;margin-bottom:4px}.fab{position:fixed;right:28px;bottom:28px;width:56px;height:56px;border-radius:50%;background:#173f2c;color:white;font-size:26px;box-shadow:0 12px 30px rgba(0,0,0,.18)}
.modal{display:none;position:fixed;inset:0;background:rgba(13,28,20,.45);align-items:center;justify-content:center;padding:20px}.modal.open{display:flex}.modal-box{background:white;border-radius:22px;padding:25px;width:min(420px,100%);box-shadow:var(--shadow)}.modal-box h2{margin-top:0}.field{margin:13px 0}.field label{display:block;font-size:12px;font-weight:700;margin-bottom:6px}.field input,.field select{width:100%;padding:11px;border:1px solid var(--line);border-radius:10px;background:#fafcf9}.modal-actions{display:flex;justify-content:flex-end;gap:8px;margin-top:18px}
.toast{position:fixed;left:50%;bottom:30px;transform:translate(-50%,20px);opacity:0;background:#173f2c;color:white;padding:12px 18px;border-radius:12px;font-size:13px;transition:.2s;pointer-events:none}.toast.show{opacity:1;transform:translate(-50%,0)}
@media(max-width:950px){.sidebar{width:75px;padding:22px 10px}.logo span,.nav button span,.bottom{display:none}.nav button{justify-content:center}.app main{margin-left:75px;width:calc(100% - 75px);padding:24px}.grid,.split{grid-template-columns:1fr}}
@media(max-width:650px){main{padding:18px!important}.top h1{font-size:24px}.hero{min-height:215px}.safe{font-size:40px}.grid,.split{grid-template-columns:1fr}.card{padding:18px}.top{margin-bottom:18px}.sidebar{display:none}.app main{margin-left:0;width:100%}}
</style>
</head>
<body>
<div class="app">
<aside class="sidebar">
  <div class="logo"><div class="logo-dot">L</div><span>Luma</span></div>
  <nav class="nav">
    <button class="active" onclick="nav(this,'Dashboard')">◉ <span>Dashboard</span></button>
    <button onclick="nav(this,'Transactions')">↕ <span>Transactions</span></button>
    <button onclick="nav(this,'Budget')">▤ <span>Budget</span></button>
    <button onclick="nav(this,'Goals')">◎ <span>Goals</span></button>
    <button onclick="nav(this,'Insights')">✦ <span>Insights</span></button>
  </nav>
  <div class="bottom"><b>September is looking good</b>You're £184 ahead of your planned spending.</div>
</aside>

<main>
  <div class="top">
    <div><div class="eyebrow">Monday, 28 September</div><h1>Good evening, Alex.</h1></div>
    <div class="user"><span style="font-size:13px;color:var(--muted)">Personal</span><div class="avatar">A</div></div>
  </div>

  <section class="grid">
    <div class="card hero">
      <div class="eyebrow label">Safe to spend this month</div>
      <div class="safe" id="safe">£1,284.60</div>
      <div class="safe-sub">after bills, budgets & savings</div>
      <div class="hero-actions"><button class="btn btn-light" onclick="openModal()">+ Add transaction</button><button class="btn btn-ghost" onclick="toast('Weekly review opened')">Review spending →</button></div>
    </div>
    <div class="card">
      <div class="card-title"><h2>September overview</h2><span class="pill">On track</span></div>
      <div style="display:flex;justify-content:space-between;margin:23px 0 5px"><span style="color:var(--muted);font-size:12px">Spent</span><b>£1,946</b></div>
      <div class="track"><div class="fill" style="width:63%"></div></div>
      <div style="display:flex;justify-content:space-between;margin-top:20px"><div><div class="eyebrow">Income</div><b style="font-size:19px">£4,280</b></div><div><div class="eyebrow">Saved</div><b style="font-size:19px">£856</b></div></div>
    </div>
  </section>

  <section class="split">
    <div class="card">
      <div class="card-title"><h2>Spending this month</h2><button class="link">View report</button></div>
      <div class="bars">
        <div class="bar-wrap"><div class="bar low"></div>W1</div><div class="bar-wrap"><div class="bar med"></div>W2</div>
        <div class="bar-wrap"><div class="bar tall"></div>W3</div><div class="bar-wrap"><div class="bar highlight"></div>W4</div>
      </div>
    </div>
    <div class="card">
      <div class="card-title"><h2>Savings goal</h2><button class="link">Details</button></div>
      <div class="goal"><div class="ring"><span>68%</span></div><div><b>Emergency fund</b><small>£3,400 of £5,000</small><div style="margin-top:8px;color:#5c7e65;font-size:12px">£200/month planned</div></div></div>
    </div>
  </section>

  <section class="split">
    <div class="card">
      <div class="card-title"><h2>Budget health</h2><button class="link" onclick="nav(null,'Budget')">Edit budget</button></div>
      <div class="budget-row"><div class="budget-top"><span>Needs</span><b>£1,190 / £1,650</b></div><div class="track"><div class="fill" style="width:72%"></div></div></div>
      <div class="budget-row"><div class="budget-top"><span>Wants</span><b>£516 / £850</b></div><div class="track"><div class="fill orange" style="width:61%"></div></div></div>
      <div class="budget-row"><div class="budget-top"><span>Savings</span><b>£856 / £856</b></div><div class="track"><div class="fill" style="width:100%"></div></div></div>
    </div>
    <div class="card">
      <div class="card-title"><h2>Money insight</h2><span class="pill">Based on your data</span></div>
      <div class="insight"><strong>Dining out is up 18% this month.</strong>You've spent £214 so far. Your usual monthly average is £181.</div>
      <div class="insight"><strong>Nice work on savings.</strong>You're on pace to reach your emergency fund goal 2 months early.</div>
    </div>
  </section>

  <section class="card" style="margin-top:20px">
    <div class="card-title"><h2>Recent transactions</h2><button class="link" onclick="nav(null,'Transactions')">See all</button></div>
    <div id="transactions">
      <div class="txn"><div class="merchant-icon">T</div><div class="txn-main"><b>Tesco</b><span>Groceries · Today</span></div><div class="amount negative">−£42.80</div></div>
      <div class="txn"><div class="merchant-icon">N</div><div class="txn-main"><b>Netflix</b><span>Entertainment · Yesterday</span></div><div class="amount negative">−£10.99</div></div>
      <div class="txn"><div class="merchant-icon">S</div><div class="txn-main"><b>Salary</b><span>Income · 25 Sep</span></div><div class="amount positive">+£2,140.00</div></div>
      <div class="txn"><div class="merchant-icon">O</div><div class="txn-main"><b>Octopus Energy</b><span>Utilities · 24 Sep</span></div><div class="amount negative">−£96.00</div></div>
    </div>
  </section>
</main>
</div>

<button class="fab" onclick="openModal()">+</button>

<div class="modal" id="modal">
 <div class="modal-box">
  <h2>Add transaction</h2>
  <div class="field"><label>Merchant</label><input id="merchant" placeholder="e.g. Tesco"></div>
  <div class="field"><label>Amount (£)</label><input id="amount" type="number" step="0.01" placeholder="0.00"></div>
  <div class="field"><label>Type</label><select id="type"><option value="expense">Expense</option><option value="income">Income</option></select></div>
  <div class="modal-actions"><button class="btn" onclick="closeModal()">Cancel</button><button class="btn" style="background:var(--green);color:white" onclick="addTransaction()">Add transaction</button></div>
 </div>
</div>
<div class="toast" id="toast"></div>

<script>
function openModal(){document.getElementById('modal').classList.add('open');document.getElementById('merchant').focus()}
function closeModal(){document.getElementById('modal').classList.remove('open')}
function toast(msg){const t=document.getElementById('toast');t.textContent=msg;t.classList.add('show');setTimeout(()=>t.classList.remove('show'),2200)}
function addTransaction(){
 const merchant=document.getElementById('merchant').value.trim()||'New transaction';
 const amount=parseFloat(document.getElementById('amount').value)||0;
 const type=document.getElementById('type').value;
 const row=document.createElement('div');row.className='txn';
 row.innerHTML=`<div class="merchant-icon">${merchant[0].toUpperCase()}</div><div class="txn-main"><b>${merchant}</b><span>${type==='income'?'Income':'Uncategorised'} · Just now</span></div><div class="amount ${type==='income'?'positive':'negative'}">${type==='income'?'+':'−'}£${amount.toFixed(2)}</div>`;
 document.getElementById('transactions').prepend(row);closeModal();toast('Transaction added');document.getElementById('merchant').value='';document.getElementById('amount').value='';
}
function nav(btn,name){
 document.querySelectorAll('.nav button').forEach(x=>x.classList.remove('active'));if(btn)btn.classList.add('active');
 if(name!=='Dashboard') toast(name+' view is ready for the next build');
}
document.getElementById('modal').addEventListener('click',e=>{if(e.target.id==='modal')closeModal()});
</script>
</body>
</html>
